# Local-only reel studio. Leave disabled until keys and spending limits are set.
BIDRANO_REELS_ENABLED=false
OPENAI_API_KEY=
REPLICATE_API_TOKEN=
# Full path to an existing FFmpeg executable (required for final MP4 and image fitting).
BIDRANO_FFMPEG_PATH=
# Multiple independently named models/accounts; never use NEXT_PUBLIC_ for secrets.
BIDRANO_AI_PROVIDERS='[{"id":"openai-video","label":"OpenAI Video","adapter":"openai-video","capability":"video","model":"sora-2","tokenEnv":"OPENAI_API_KEY","seconds":[4,8,12]},{"id":"openai-image","label":"OpenAI Image","adapter":"openai-image","capability":"image","model":"gpt-image-1","tokenEnv":"OPENAI_API_KEY","seconds":[4]}]'
